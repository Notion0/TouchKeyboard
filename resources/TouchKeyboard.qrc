<!DOCTYPE RCC>
<RCC version="1.0">
 <!-- prefix 为 /touchkeyboard，文件路径含 icons/ 段：资源全路径 = :/touchkeyboard/icons/xxx.png
      （与代码里的 QIcon 路径一一对应；勿把 icons 同时写进 prefix 和文件路径） -->
 <qresource prefix="/touchkeyboard">
  <file>icons/backspace.png</file>
  <file>icons/caplock.png</file>
  <file>icons/enter.png</file>
  <file>icons/hideBtn.png</file>
  <file>icons/space.png</file>
 </qresource>
 <!-- 中文拼音三字典（随模板编入=中文输入法是固有能力，不是可选项）：资源全路径
      与 Keyboard.cpp 的 TOUCHKBD_* 宏默认值逐字一致（:/ChineseLib/pinyin.txt 等），
      宿主 include .pri 即得完整中文输入，无需提供任何字典 -->
 <qresource prefix="/ChineseLib">
  <file>dicts/pinyin.txt</file>
 </qresource>
 <qresource prefix="/ChinesePhraseLib">
  <file>dicts/pinyin_phrase.txt</file>
 </qresource>
 <qresource prefix="/GoogleChineseLib">
  <file>dicts/rawdict_utf16_65105_freq_sort.txt</file>
 </qresource>
</RCC>
